    {
      "type": "row",
      "title": "Fleet spread and arrival (optional, needs a Loki datasource)",
      "id": 23,
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "Fleet spread per block (ms)",
          "id": 21,
          "gridPos": {
            "x": 0,
            "y": 62,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${loki}"
              },
              "expr": "avg((\n  max by (msg_id) (max_over_time({unit=\"eth-gossip-overlay.service\"} | json | event=\"first_arrival\" | topic=~\".*beacon_block.*\" | unwrap first_arrival_ns [5m]))\n  -\n  min by (msg_id) (min_over_time({unit=\"eth-gossip-overlay.service\"} | json | event=\"first_arrival\" | topic=~\".*beacon_block.*\" | unwrap first_arrival_ns [5m]))\n) / 1e6)",
              "refId": "A",
              "legendFormat": "mean"
            },
            {
              "datasource": {
                "type": "loki",
                "uid": "${loki}"
              },
              "expr": "max((\n  max by (msg_id) (max_over_time({unit=\"eth-gossip-overlay.service\"} | json | event=\"first_arrival\" | topic=~\".*beacon_block.*\" | unwrap first_arrival_ns [5m]))\n  -\n  min by (msg_id) (min_over_time({unit=\"eth-gossip-overlay.service\"} | json | event=\"first_arrival\" | topic=~\".*beacon_block.*\" | unwrap first_arrival_ns [5m]))\n) / 1e6)",
              "refId": "B",
              "legendFormat": "worst host pair"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 8,
                "showPoints": "never",
                "spanNulls": true
              },
              "unit": "ms"
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "First arrival to last arrival of one block across the fleet, the first canary criterion. LogQL has no quantile across series, so the panel shows the mean and the worst block; docs/rollout.md says how to get the p50 and p99 the criterion is written in."
        },
        {
          "type": "timeseries",
          "title": "Arrival to import (v3)",
          "id": 22,
          "gridPos": {
            "x": 12,
            "y": 62,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${loki}"
              },
              "expr": "sum(count_over_time({unit=\"eth-gossip-overlay.service\"} | json | event=\"import\" [5m]))",
              "refId": "A",
              "legendFormat": "import events"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 8,
                "showPoints": "never",
                "spanNulls": true
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "Import time comes from the beacon node's event stream in v3 (T-084) as a second event joined by msg_id. Until that ships this panel counts import events, and there are none."
        }
      ]
    }
