      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Frames and bytes on one axis, because what matters is that neither is sitting near its bound. Which peer it is comes from eth-gossip-overlayctl status."
    },
    {
      "type": "timeseries",
      "title": "Dropped per second, by lane",
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 28,
