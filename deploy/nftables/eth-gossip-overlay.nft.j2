# Rendered from roster.yaml: UDP 7788 is dropped from every address that is not a fleet host.
# Nothing else on the host is touched, and re-running the file replaces the table as a whole.
#
# Two address families, so two sets and two rules: an nftables set holds one family only.

table inet eth-gossip-overlay
delete table inet eth-gossip-overlay

table inet eth-gossip-overlay {
	set overlay_peers_v4 {
		type ipv4_addr
	}

	set overlay_peers_v6 {
		type ipv6_addr
	}

	chain overlay_input {
		type filter hook input priority filter; policy accept;
		udp dport 7788 ip saddr != @overlay_peers_v4 drop
		udp dport 7788 ip6 saddr != @overlay_peers_v6 drop
	}
}

{% for host in hosts -%}
{% if "]" in host.addr -%}
add element inet eth-gossip-overlay overlay_peers_v6 { {{ host.addr | replace("[", "") | split("]") | first }} }
{% else -%}
add element inet eth-gossip-overlay overlay_peers_v4 { {{ host.addr | split(":") | first }} }
{% endif -%}
{% endfor -%}
