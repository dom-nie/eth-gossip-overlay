[Unit]
Description=Fleet gossip overlay sidecar
Documentation=https://github.com/dom-nie/eth-bn-gossip-overlay
After=network-online.target
Wants=network-online.target
# A pull-in and nothing stronger, so neither unit's restart touches the other. Rename this if
# your Lighthouse unit is called something else.
Wants=lighthouse-bn.service
# A crash loop backs off to a minute and is never stopped for good; an overlay that keeps
# trying is worth more than one systemd gave up on overnight.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# Fed only while the connection manager, the BN link, the fanout and the publisher are all
# going round, so a wedged sidecar is restarted rather than left half alive.
WatchdogSec=30
Restart=always
RestartSec=2
# RestartSteps= and RestartMaxDelaySec= need systemd 254 or newer.
RestartSteps=6
RestartMaxDelaySec=60

ExecStart=/usr/local/bin/fleet-overlay run
# systemctl reload re-reads config.yaml and roster.yaml without dropping a connection.
ExecReload=/bin/kill -HUP $MAINPID

# The seed is read from $CREDENTIALS_DIRECTORY/seed, so no service user owns it and none has to
# exist. For the encrypted variant run
#   systemd-creds encrypt --name=seed seed /etc/fleet-overlay/seed.cred
# on the host and replace the line below with
#   LoadCredentialEncrypted=seed:/etc/fleet-overlay/seed.cred
LoadCredential=seed:/etc/fleet-overlay/seed
DynamicUser=yes
# FLEET_OVERLAY_HOSTNAME, so the roster key comes from your inventory and cannot drift from
# whatever gethostname() happens to say. Optional: without it the sidecar asks the kernel.
EnvironmentFile=-/etc/fleet-overlay/fleet-overlay.env

# /var/lib/fleet-overlay holds the node key, /run/fleet-overlay the admin socket and the
# lighthouse.env the beacon node's drop-in reads. Both are systemd's to create and clean up.
StateDirectory=fleet-overlay
RuntimeDirectory=fleet-overlay
ProtectSystem=strict
PrivateTmp=yes

CPUWeight=200
# No CPUQuota=: CFS throttling would stall a fanout in the middle of a block.
MemoryMax=512M
# Cores reserved for the sidecar on hosts that have them, excluded from the beacon node's own
# AllowedCPUs=. Host-specific, so it is off here.
#AllowedCPUs=<CPU_LIST>

[Install]
WantedBy=multi-user.target
