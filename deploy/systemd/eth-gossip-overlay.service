[Unit]
Description=Eth gossip overlay sidecar
Documentation=https://github.com/dom-nie/eth-gossip-overlay
After=network-online.target
Wants=network-online.target
# A pull-in and nothing stronger, so neither unit's restart touches the other. Rename this if
# your Lighthouse unit is called something else.
Wants=lighthouse-bn.service
# A crash loop backs off to a minute and is never stopped for good; an overlay that keeps
# trying is worth more than one systemd gave up on overnight.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# Fed only while the connection manager, the BN link, the fanout and the publisher are all
# going round, so a wedged sidecar is restarted rather than left half alive.
WatchdogSec=30
Restart=always
RestartSec=2
# RestartSteps= and RestartMaxDelaySec= need systemd 254 or newer.
RestartSteps=6
RestartMaxDelaySec=60
# The sidecar bounds its own stop to two seconds and gives up on a hung ethtool two seconds
# after that. This is the fence behind both, in place of systemd's ninety-second default.
TimeoutStopSec=10

ExecStart=/usr/local/bin/eth-gossip-overlay run
# systemctl reload re-reads config.yaml and roster.yaml without dropping a connection.
ExecReload=/bin/kill -HUP $MAINPID

# The seed is read from $CREDENTIALS_DIRECTORY/seed, so no service user owns it and none has to
# exist. For the encrypted variant run
#   systemd-creds encrypt --name=seed seed /etc/eth-gossip-overlay/seed.cred
# on the host and replace the line below with
#   LoadCredentialEncrypted=seed:/etc/eth-gossip-overlay/seed.cred
LoadCredential=seed:/etc/eth-gossip-overlay/seed
DynamicUser=yes
# ETH_GOSSIP_OVERLAY_HOSTNAME, so the roster key comes from your inventory and cannot drift from
# whatever gethostname() happens to say. Optional: without it the sidecar asks the kernel.
EnvironmentFile=-/etc/eth-gossip-overlay/eth-gossip-overlay.env

# /var/lib/eth-gossip-overlay holds the node key, /run/eth-gossip-overlay the admin socket and the
# lighthouse.env the beacon node's drop-in reads. Both are systemd's to create and clean up.
StateDirectory=eth-gossip-overlay
RuntimeDirectory=eth-gossip-overlay
ProtectSystem=strict
PrivateTmp=yes

CPUWeight=200
# No CPUQuota=: CFS throttling would stall a fanout in the middle of a block.
# The bounded structures at a 200-host roster come to about 816 MiB once OPS-N4's 25% headroom
# is on them; docs/performance.md has the row-by-row table. Raise this and the alert's literal
# and the dashboard's threshold lines have to move with it.
MemoryMax=1G
# Cores reserved for the sidecar on hosts that have them, excluded from the beacon node's own
# AllowedCPUs=. Host-specific, so it is off here.
#AllowedCPUs=<CPU_LIST>

[Install]
WantedBy=multi-user.target
